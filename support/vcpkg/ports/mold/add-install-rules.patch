diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8fd8fdd..669da74 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -564,10 +564,11 @@ add_library(mdlib ${CORE_FILES} ${SRC_FILES} ${EXT_FILES} ${GEN_FILES} ${SHADER_
 
 target_include_directories(mdlib
   PUBLIC
-  src/
-  ext/gl3w/
-  ext/simde/
-  ext/xxhash/
+  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
+  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/ext/gl3w>
+  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/ext/simde>
+  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/ext/xxhash>
+  $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/mold>
 
   PRIVATE
   ${GEN_DIR}
@@ -672,6 +673,57 @@ set_source_files_properties(${EXT_FILES}, PROPERTIES COMPILE_OPTIONS ${MD_FLAGS_
 target_compile_features(mdlib PRIVATE c_std_11)
 target_link_libraries(mdlib PUBLIC ${MD_LIBS})
 
+# Install / export
+include(GNUInstallDirs)
+include(CMakePackageConfigHelpers)
+
+install(TARGETS mdlib
+  EXPORT moldTargets
+  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+  RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
+
+install(DIRECTORY src/
+  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/mold
+  FILES_MATCHING
+    PATTERN "*.h"
+    PATTERN "*.inl"
+    PATTERN "shaders" EXCLUDE
+)
+
+install(DIRECTORY ext/simde/simde/
+  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/mold/simde
+  FILES_MATCHING
+    PATTERN "*.h"
+)
+
+install(FILES ext/xxhash/xxhash.h
+  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/mold
+)
+
+install(EXPORT moldTargets
+  FILE mold-targets.cmake
+  NAMESPACE mold::
+  DESTINATION ${CMAKE_INSTALL_DATAROOTDIR}/mold
+)
+
+configure_package_config_file(
+  ${CMAKE_CURRENT_SOURCE_DIR}/moldConfig.cmake.in
+  ${CMAKE_CURRENT_BINARY_DIR}/moldConfig.cmake
+  INSTALL_DESTINATION ${CMAKE_INSTALL_DATAROOTDIR}/mold
+)
+write_basic_package_version_file(
+  ${CMAKE_CURRENT_BINARY_DIR}/moldConfigVersion.cmake
+  VERSION 2026.10.17
+  COMPATIBILITY AnyNewerVersion
+)
+install(FILES
+  ${CMAKE_CURRENT_BINARY_DIR}/moldConfig.cmake
+  ${CMAKE_CURRENT_BINARY_DIR}/moldConfigVersion.cmake
+  DESTINATION ${CMAKE_INSTALL_DATAROOTDIR}/mold
+)
+
 get_directory_property(has_parent PARENT_DIRECTORY)
 if (has_parent)
     set(MD_DEFINES ${MD_DEFINES} PARENT_SCOPE)
