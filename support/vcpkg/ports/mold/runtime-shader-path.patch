+// ---------------------------------------------------------------------------
+// Runtime shader path resolution
+//
+// OpenSpace layout on all platforms in a release build:
+//   <root>/bin/openspace    <- executable
+//   <root>/modules/molecule/shaders/mold/   <- copied out of the mold vcpkg package
+// OpenSpace layout on Windows in development build:
+//   <root>/bin/<Configuration>/OpenSpace  <- executable
+//
+// Resolves <exe_dir>/../modules/molecule/shaders/mold/<file>
+// or <exe_dir>/../../modules/molecule/shaders/mold/<file>
+// at runtime: works for .deb, AppImage, Windows, and macOS.
+// ---------------------------------------------------------------------------
+#define MD_SHADER_PATH_SLOTS 8
+#define MD_SHADER_PATH_LEN   512
+
+static const char* md_gl_shader_path(const char* filename) {
+    static char bufs[MD_SHADER_PATH_SLOTS][MD_SHADER_PATH_LEN];
+    static int slot = 0;
+    char* buf = bufs[slot % MD_SHADER_PATH_SLOTS];
+    slot++;
+    str_t exe_dir = md_path_exe_dir();
+    if (str_ends_with(exe_dir, STR("bin/"))) {
+        snprintf(buf, MD_SHADER_PATH_LEN,
+            "%.*s../modules/molecule/shaders/mold%s",
+            (int)exe_dir.len, exe_dir.ptr,
+            filename);
+    }
+    else {
+        snprintf(buf, MD_SHADER_PATH_LEN,
+            "%.*s../../modules/molecule/shaders/mold%s",
+            (int)exe_dir.len, exe_dir.ptr,
+            filename);
+    }
+    return buf;
+}
