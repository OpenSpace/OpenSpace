# Entry point of the OpenSpace AppImage. Generated from support/appimage/AppRun.in.
#
# The whole staged install tree is the AppDir's usr/, so usr/ is the installation root.
# Everything about running out of a directory the user cannot write to is handled by
# support/linux/openspace-launcher.in, which the DEB and RPM packages use as well; all this
# has to add is the library and plugin environment that the AppRun generated by linuxdeploy
# would otherwise have set, and the root, which cannot be derived from the launcher's own
# location here because it is reached through the AppDir rather than through <root>/bin.

set -e

HERE="$(dirname "$(readlink -f "$0")")"

export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$HERE/usr/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

export OPENSPACE_ROOT="$HERE/usr"
exec "$HERE/usr/bin/openspace-launcher" "$@"
