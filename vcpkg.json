{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "openspace",
  "version-string": "0.22.0-dev",
  "description": [
    "OpenSpace."
  ],
  "homepage": "https://www.openspaceproject.com",
  "license": "MIT",
  "supports": "!(osx | uwp | android)",
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "builtin",
      "baseline": "04a9d8e5212d01ee1dd9478eadd9caade4f8b0d4"
    },
    "overlay-ports": [
      "./support/vcpkg/ports",
      "./apps/OpenSpace/ext/sgct/support/vcpkg/ports",
      "./ext/spice/support/vcpkg/ports",
      "./support/coding/codegen/support/vcpkg/ports"
    ],
    "overlay-triplets": [
      "./support/vcpkg/triplets"
    ]
  },
  "dependencies": [
    {
      "name": "assimp",
      "features": [
        "draco"
      ]
    },
    "catch2",
    "ccfits",
    {
      "name": "cfitsio",
      "features": [
        "curl"
      ]
    },
    "codegen",
    "curl",
    {
      "name": "date",
      "default-features": false
    },
    {
      "name": "freetype",
      "default-features": false
    },
    "gdal",
    "geos",
    {
      "name": "imgui",
      "default-features": false
    },
    "glbinding",
    "glm",
    "json-schema-validator",
    "kameleon",
    "kubazip",
    "lua",
    "lz4",
    "mold",
    "nlohmann-json",
    "openjpeg",
    "oscpack",
    "scnlib",
    "sgct",
    "soloud",
    "spice",
    {
      "name": "spout2",
      "platform": "windows"
    },
    "stbimage",
    "tiny-process-library",
    "tinyxml2",
    "tracy",
    "tuio",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "websocketpp"
  ],
  "features": {
    "qt": {
      "description": "Build Qt through vcpkg instead of using a Qt provided by the system",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "widgets",
            "network",
            "png",
            "freetype",
            "harfbuzz"
          ]
        },
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "windeployqt"
          ],
          "platform": "windows"
        },
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "xcb",
            "wayland",
            "fontconfig"
          ],
          "platform": "linux"
        },
        {
          "name": "qtwayland",
          "platform": "linux"
        }
      ]
    },
    "tests": {
      "description": "Build the unit tests",
      "dependencies": [
        "catch2"
      ]
    },
    "profiling": {
      "description": "Enable profiling support through Tracy",
      "dependencies": [
        "tracy"
      ]
    },
    "openvr": {
      "description": "Build the OpenSpace application with OpenVR/SteamVR support",
      "dependencies": [
        "openvr"
      ]
    }
  }
}
