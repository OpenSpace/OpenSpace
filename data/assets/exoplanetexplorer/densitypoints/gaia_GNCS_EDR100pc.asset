
local colormaps = asset.require("util/default_colormaps")

local data = asset.resource({
  Name = "GCNS_EDR100pc CSV Data",
  Type = "UrlSynchronization",
  Identifier = "gcns_edr100pc_csv_data",
  Url = "https://data.openspaceproject.com/testing/exoplanetexplorer_data/GCNS_EDR100pc.csv"
})


local Node ={
  Identifier = "CastDensityPoints_GaiaEDR_100pc",
  Renderable = {
    Enabled = asset.enabled,
    Type = "RenderableDensityPointCloud",
    File = data .. "GCNS_EDR100pc.csv",
    XColumn = "px", YColumn = "py", ZColumn = "pz",
    Unit = "pc",
    GridDimensions = { 128, 128, 128 },
    Color = {
      ColorMap = colormaps.Uniform.Viridis
    },
    PointSize = 3,
    BoundingBox = {
      Enabled = true
    },
    Opacity = 0.5
  },
  GUI = {
    Name = "Gaia Density Points (GCNS_EDR100pc)",
    Description = "Density points representing the Gaia test dataset within 100pc (GCNS_EDR100pc).",
    Path = "/ExoplanetExplorer/Density Points"
  }
}

asset.onInitialize(function ()
  openspace.addSceneGraphNode(Node)

end)

asset.onDeinitialize(function ()
  openspace.removeSceneGraphNode(Node)
end)
