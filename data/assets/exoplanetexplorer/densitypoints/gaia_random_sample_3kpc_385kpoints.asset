
local colormaps = asset.require("util/default_colormaps")

local data = asset.resource({
  Name = "Gaia DR3 Random Sample 3kpc 385k Points CSV Data",
  Type = "UrlSynchronization",
  Identifier = "gaia_dr3_random_sample_3kpc_385kpoints_csv_data",
  Url = "https://data.openspaceproject.com/testing/exoplanetexplorer_data/gaia_dr3_random_sample_3kpc_385kpoints_galactic_xyz.csv"
})

local Node ={
  Identifier = "CastDensityPoints_GaiaRandomSample_3kpc_385kpoints",
  Renderable = {
    Enabled = asset.enabled,
    Type = "RenderableDensityPointCloud",
    File = data .. "gaia_dr3_random_sample_3kpc_385kpoints_galactic_xyz.csv",
    XColumn = "x", YColumn = "y", ZColumn = "z",
    Unit = "pc",
    GridDimensions = { 128, 128, 128 },
    Color = {
      ColorMap = colormaps.Uniform.Viridis
    },
    PointSize = 3,
    BoundingBox = {
      Enabled = true
    },
    Opacity = 0.5
  },
  GUI = {
    Name = "Gaia Random Sample in 3kpc - 385k Points",
    Description = "Density points representing a random sample from the Gaia DR3 catalog in galactic XYZ coordinates.",
    Path = "/ExoplanetExplorer/Density Points"
  }
}

asset.onInitialize(function ()
  openspace.addSceneGraphNode(Node)

end)

asset.onDeinitialize(function ()
  openspace.removeSceneGraphNode(Node)
end)
