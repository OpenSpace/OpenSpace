asset.require("base_blank")

-- Modules and component settings
asset.require("modules/exoplanets/exoplanets")

-- Exoplanet tool module (a little ugly but that's ok for now) @TODO make an asset for this
openspace.setPropertyValueSingle("Modules.ExoplanetExplorer.Enabled", true)

-- Specifying which other assets should be loaded in this scene
asset.require("scene/solarsystem/sun/sun")
asset.require("scene/solarsystem/sun/glare")
asset.require("scene/solarsystem/sun/habitablezone")
asset.require("scene/solarsystem/sun/layers/default_layers")
asset.require("scene/milkyway/milkyway/volume")

-- Some DU assets related to the Milky way
asset.require("scene/digitaluniverse/allsky_visible")
asset.require("scene/digitaluniverse/constellationbounds")
asset.require("scene/digitaluniverse/constellations")
asset.require("scene/digitaluniverse/brown_dwarfs")
asset.require("scene/digitaluniverse/exoplanets")
asset.require("scene/digitaluniverse/globularclusters")
asset.require("scene/digitaluniverse/grids")
asset.require("scene/digitaluniverse/h2regions")
asset.require("scene/digitaluniverse/milkyway")
asset.require("scene/digitaluniverse/obassociations")
asset.require("scene/digitaluniverse/openclusters")
asset.require("scene/digitaluniverse/planetarynebulae")
asset.require("scene/digitaluniverse/pulsars")
asset.require("scene/digitaluniverse/starlabels")
asset.require("scene/digitaluniverse/stars")
asset.require("scene/digitaluniverse/supernovaremnants")
asset.require("scene/digitaluniverse/white_dwarfs")

asset.require("actions/default_actions")

asset.onInitialize(function ()
  -- Reset dpi scaling from base_blank asset
  openspace.setPropertyValueSingle("Modules.CefWebGui.GuiScale", 1.0)

  -- Host the data in the data folder

  local directories = openspace.propertyValue("Modules.WebGui.Directories")

  -- Add asset folders (first the endpoint, and then the path to the hosted files)
  directories[#directories + 1] = "exoplanetexplorer/data"
  directories[#directories + 1] = openspace.absPath("${MODULE_EXOPLANETEXPLORER}/data")

  directories[#directories + 1] = "exoplanetexplorer/web"
  directories[#directories + 1] = openspace.absPath("${MODULE_EXOPLANETEXPLORER}/webpage")

  openspace.setPropertyValueSingle("Modules.WebGui.Directories", directories)

  -- Set the hosted data location for the Exoplanet Explorer module, so the webpage
  -- can interpret if the current data is hosted locally or not
  openspace.setPropertyValueSingle(
    "Modules.ExoplanetExplorer.HostedDataLocation",
    openspace.absPath("${MODULE_EXOPLANETEXPLORER}/data")
  )
end)

asset.onDeinitialize(function ()
end)
