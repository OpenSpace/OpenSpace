local DomeSetup = {
  Identifier = "os.exoplanetexplorer_dome_setup",
  Name = "Dome Setup (Nkpg dome)",
  Command = [[
    openspace.setPropertyValueSingle("OpenSpaceEngine.PropertyVisibility", 4)
    openspace.setPropertyValue("{exoplanet_explorer_glyphs}.Renderable.OrientationRenderOption", 1)
    openspace.setPropertyValueSingle("RenderEngine.MasterRotation", {-1.03, 0.0, 0.0 })
    openspace.setPropertyValueSingle("Dashboard.StartPositionOffset", { 20.0, 60.0 })

    -- Remove fade glyphs event - does not work in dome
    openspace.asset.remove("${ASSETS}/exoplanetexplorer/events/fade_glyphs.asset")

    -- Live charts should be made bigger for the dome setup
    openspace.setPropertyValueSingle("ScreenSpace.ScreenSpaceBrowser_ScatterPlotMatrix.Placement.Scale", 0.630000)
    openspace.setPropertyValueSingle("ScreenSpace.ScreenSpaceBrowser_ScatterPlotMatrix.Placement.RadiusAzimuthElevation", {2.000000,1.064651,0.575959})
    openspace.setPropertyValueSingle("ScreenSpace.ScreenSpaceBrowser_ScatterPlotMatrix.ZoomLevel", 2.700000)
    openspace.setPropertyValueSingle("ScreenSpace.ScreenSpaceBrowser_ScatterPlotMatrix.Dimensions", {1920.000000,1800.000000})

    openspace.setPropertyValueSingle("ScreenSpace.ScreenSpaceBrowser_ParallelCoordinates.Dimensions", {3000.000000,1679.000000})
    openspace.setPropertyValueSingle("ScreenSpace.ScreenSpaceBrowser_ParallelCoordinates.ZoomLevel", 2.870000)
    openspace.setPropertyValueSingle("ScreenSpace.ScreenSpaceBrowser_ParallelCoordinates.Placement.RadiusAzimuthElevation", {2.000000,5.323254,0.418879})
    openspace.setPropertyValueSingle("ScreenSpace.ScreenSpaceBrowser_ParallelCoordinates.Placement.Scale", 0.650000)
  ]],
  Documentation = [[ExoplanetExplorer dome setup (Nkpg dome)]],
  GuiPath = "/ExoplanetExplorer",
  IsLocal = false
}
asset.export("DomeSetup", DomeSetup.Identifier)

asset.onInitialize(function()
  openspace.action.registerAction(DomeSetup)
end)

asset.onDeinitialize(function()
  openspace.action.removeAction(DomeSetup)
end)
