local transforms = asset.require("../transforms")
local kernels = asset.require("../kernels")
local coreKernels = asset.require("spice/core")



local labelsPath = asset.resource({
  Name = "Jupiter Labels",
  Type = "HttpSynchronization",
  Identifier = "jupiter_labels",
  Version = 1
})


local Callisto = {
  Identifier = "Callisto",
  Parent = transforms.JupiterBarycenter.Identifier,
  Transform = {
    Translation = {
      Type = "SpiceTranslation",
      Target = kernels.ID.Callisto,
      Observer = coreKernels.ID.JupiterBarycenter
    },
    Rotation = {
      Type = "SpiceRotation",
      SourceFrame = coreKernels.Frame.Callisto,
      DestinationFrame = coreKernels.Frame.Galactic
    }
  },
  Renderable = {
    Type = "RenderableGlobe",
    Radii = 2410000,
    -- Hapke Parameters (AI-cited)
    -- https://doi.org/10.18372/2411-6602.08.2209
    Hapke = {
      W = 0.198,
      Theta = 21.0,
      C = 0.0,
      B = -0.245,
      BS0 = 0.954, 
      BC0 = 0.0,
      HS = 0.027, 
      HC = 0.0,
      Phi = 0.0
    },
    Labels = {
      Enabled = false,
      FileName = labelsPath .. "callisto.labels",
      AlignmentOption = "Horizontally", -- or Circularly
      FontSize = 20.0,
      Size = 11.5,
      MinMaxSize = { 1, 100 },
      FadeInEnabled = true,
      FadeOutEnabled = true,
      FadeDistances = { 5000000.0, 15000000.0 },
      DistanceEPS = 1350000.0,
      Color = { 1.0, 1.0, 0.0 }
    }
  },
  Tag = { "moon_solarSystem", "moon_giants", "moon_jupiter", "moon_major_jupiter" },
  GUI = {
    Path = "/Solar System/Planets/Jupiter/Major Moons/Callisto"
  }
}


asset.onInitialize(function()
  openspace.addSceneGraphNode(Callisto)
end)

asset.onDeinitialize(function()
  openspace.removeSceneGraphNode(Callisto)
end)

asset.export(Callisto)



asset.meta = {
  Name = "Callisto",
  Description = "Callisto globe",
  Author = "OpenSpace Team",
  URL = "https://openspaceproject.com",
  License = "MIT license"
}
