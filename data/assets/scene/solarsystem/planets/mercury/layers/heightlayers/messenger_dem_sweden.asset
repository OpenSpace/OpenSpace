local mercuryAsset = asset.require("scene/solarsystem/planets/mercury/globe")

local Layer = {
  Identifier = "Messenger_DEM_Sweden",
  Name = "Messenger DEM [Sweden]",
  Enabled = asset.enabled,
  ZIndex = 10,
  FilePath = asset.resource("messenger_dem_sweden.wms"),
  Settings = { Multiplier = 0.5 },
  TilePixelSize = 512
}


asset.onInitialize(function()
  openspace.globebrowsing.addLayer(mercuryAsset.Mercury.Identifier, "HeightLayers", Layer)
end)

asset.onDeinitialize(function()
  openspace.globebrowsing.deleteLayer(mercuryAsset.Mercury.Identifier, "HeightLayers", Layer)
end)

asset.export("layer", Layer)
