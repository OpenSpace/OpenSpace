local transforms = asset.require("./transforms")



local Triton = {
  Identifier = "Triton",
  Parent = transforms.TritonPosition.Identifier,
  -- Triton (AI-cited)
  -- Very limited. Only W.
  -- https://doi.org/10.1029/91JA01464 and https://doi.org/10.1029/91JA01736
  Hapke = {
    W = 0.96, -- Official value.
    Theta = 10.0,
    C = 0.0,
    B = -0.40,
    BS0 = 0.0,
    BC0 = 0.0,
    HS = 0.0,
    HC = 0.0,
    Phi = 0.0
  },
  Renderable = {
    Type = "RenderableGlobe",
    Radii = { 2709000, 2706000, 2705000 }
  },
  Tag = { "moon_solarSystem", "moon_giants", "moon_neptune", "moon_major_neptune" },
  GUI = {
    Name = "Triton",
    Path = "/Solar System/Planets/Neptune/Major Moons/Triton"
  }
}


asset.onInitialize(function()
  openspace.addSceneGraphNode(Triton)
end)

asset.onDeinitialize(function()
  openspace.removeSceneGraphNode(Triton)
end)

asset.export(Triton)



asset.meta = {
  Name = "Triton",
  Description = [[Globe asset containing Neptune's moon Triton]],
  Author = "OpenSpace Team",
  URL = "https://openspaceproject.com",
  License = "MIT license"
}
