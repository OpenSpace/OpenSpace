local transforms = asset.require("./transforms")
local coreKernels = asset.require("spice/core")



local Oberon = {
  Identifier = "Oberon",
  Parent = transforms.OberonPosition.Identifier,
  -- Hapke Parameters (AI-cited).
  -- https://doi.org/10.1006/icar.2001.6596
  Hapke = {
    W = 0.43,
    Theta = 23.0,
    C = 0.0,
    B = -0.28,
    BS0 = 0.75,
    BC0 = 4.0,
    HS = 0.025,
    HC = 0.001,
    Phi = 0.0
  },
  Renderable = {
    Type = "RenderableGlobe",
    Radii = { 1522800, 1522800, 1522800 }
  },
  Tag = {
    "moon_solarSystem",
    "moon_giants",
    "moon_uranus",
    "moon_major",
    "moon_major_uranus"
  },
  GUI = {
    Name = "Oberon",
    Path = "/Solar System/Planets/Uranus/Major Moons/Oberon"
  }
}


asset.onInitialize(function()
  openspace.addSceneGraphNode(Oberon)
end)

asset.onDeinitialize(function()
  openspace.removeSceneGraphNode(Oberon)
end)

asset.export(Oberon)



asset.meta = {
  Name = "Oberon Globe",
  Description = [[Globe for Oberon]],
  Author = "OpenSpace Team",
  URL = "https://openspaceproject.com",
  License = "MIT license"
}
