local transforms = asset.require("scene/solarsystem/sun/transforms")
local coreKernels = asset.require("spice/core")



local ITRF93Kernels = asset.resource({
  Name = "ITRF93 Kernels",
  Type = "HttpSynchronization",
  Identifier = "itrf93_kernels",
  Version = 1
})

local EarthBarycenter = {
  Identifier = "EarthBarycenter",
  Parent = transforms.SolarSystemBarycenter.Identifier,
  Transform = {
    Translation = {
      Type = "SpiceTranslation",
      Target = coreKernels.ID.EarthBarycenter,
      Observer = coreKernels.ID.SolarSystemBarycenter
    }
  },
  GUI = {
    Name = "Earth Barycenter",
    Path = "/Solar System/Planets/Earth",
    Focusable = false,
    Hidden = true
  }
}

local EarthCenter = {
  Identifier = "EarthCenter",
  Parent = EarthBarycenter.Identifier,
  Transform = {
    Translation = {
      Type = "SpiceTranslation",
      Target = coreKernels.ID.Earth,
      Observer = coreKernels.ID.EarthBarycenter
    }
  },
  GUI = {
    Name = "Earth Center",
    Path = "/Solar System/Planets/Earth",
    Focusable = false,
    Hidden = true
  }
}

local EarthInertial = {
  -- The default reference frame for Earth-orbiting satellites
  Identifier = "EarthInertial",
  Parent = EarthCenter.Identifier,
  Transform = {
    Rotation = {
      Type = "SpiceRotation",
      SourceFrame = coreKernels.Frame.J2000,
      DestinationFrame = coreKernels.Frame.Galactic
    }
  },
  GUI = {
    Name = "Earth Inertial",
    Path = "/Solar System/Planets/Earth",
    Focusable = false,
    Hidden = true
  }
}

local EarthIAU = {
  Identifier = "EarthIAU",
  Parent = EarthCenter.Identifier,
  Transform = {
    Rotation = {
      Type = "TimelineRotation",
      Keyframes = {
        -- The next keyframe is also evaluated, so this one has to be inside the ITRF93
        -- coverage, which starts at 1962-01-20
        ["1962-01-21T00:00:00"] = {
          Type = "SpiceRotation",
          SourceFrame = coreKernels.Frame.Earth,
          DestinationFrame = coreKernels.Frame.Galactic
        },
        ["1962-01-22T00:00:00"] = {
          Type = "SpiceRotation",
          SourceFrame = coreKernels.Frame.ITRF93,
          DestinationFrame = coreKernels.Frame.Galactic
        },
        -- The ITRF93 coverage ends at 2099-08-25
        ["2099-08-24T00:00:00"] = {
          Type = "SpiceRotation",
          SourceFrame = coreKernels.Frame.Earth,
          DestinationFrame = coreKernels.Frame.Galactic
        }
      },
      ShouldInterpolate = false
    }
  },
  GUI = {
    Name = "Earth IAU",
    Path = "/Solar System/Planets/Earth",
    Focusable = false,
    Hidden = true,
    Description = [[The body-fixed rotation of the Earth. Between 1962-01-22 and 2099-08-24
      the high-precision ITRF93 frame is used, which includes precession, nutation, and
      polar motion. Outside of this time range, the lower-precision IAU_EARTH frame is
      used instead.]]
  }
}


asset.onInitialize(function()
  openspace.spice.loadKernel(ITRF93Kernels .. "earth_200101_990825_predict.bpc")
  openspace.spice.loadKernel(ITRF93Kernels .. "earth_620120_240827.bpc")
  openspace.spice.loadKernel(ITRF93Kernels .. "earth_latest_high_prec.bpc")

  openspace.addSceneGraphNode(EarthBarycenter)
  openspace.addSceneGraphNode(EarthCenter)
  openspace.addSceneGraphNode(EarthInertial)
  openspace.addSceneGraphNode(EarthIAU)
end)

asset.onDeinitialize(function()
  openspace.removeSceneGraphNode(EarthIAU)
  openspace.removeSceneGraphNode(EarthInertial)
  openspace.removeSceneGraphNode(EarthCenter)
  openspace.removeSceneGraphNode(EarthBarycenter)

  openspace.spice.unloadKernel(ITRF93Kernels .. "earth_latest_high_prec.bpc")
  openspace.spice.unloadKernel(ITRF93Kernels .. "earth_620120_240827.bpc")
  openspace.spice.unloadKernel(ITRF93Kernels .. "earth_200101_990825_predict.bpc")
end)

asset.export(EarthBarycenter)
asset.export(EarthCenter)
asset.export(EarthInertial)
asset.export(EarthIAU)



asset.meta = {
  Name = "Earth Transforms",
  Description = [[Earth transforms: Earth Barycenter, Earth Center, Earth Inertial, Earth
    IAU. A scene graph node is created for each transform]],
  Author = "OpenSpace Team",
  URL = "https://openspaceproject.com",
  License = "MIT license"
}
